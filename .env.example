# Azure AI Foundry project configuration. The endpoint form is preferred by
# current Azure SDK versions; legacy connection strings are also supported.
AZURE_AI_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_PROJECT_CONNECTION_STRING=""

# Deployment names must exactly match deployments in the Foundry project.
ORCHESTRATOR_MODEL="gpt-5.6-sol"
POLICY_MODEL="Cohere-command-a-plus-05-2026"
ROUTER_MODEL="DeepSeek-V4-Flash"

# Optional: retained only if you run a separate Telegram integration.
TELEGRAM_BOT_TOKEN=""
